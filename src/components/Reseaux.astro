---
// Les liens vers les réseaux et sites, sur Contact et sous le nom d'une
// fiche. Un lien vide n'est pas rendu, et sans aucun lien le bloc non plus.
// Avec `icone` le lien est un rond portant le logo du réseau, sinon une
// pastille de texte.
import IconeReseau from './IconeReseau.astro';
import Pastille from './Pastille.astro';
import { T } from '../lib/textes.js';

interface Props {
  liens: { href: string | null; label: string; icone?: 'instagram' | 'facebook' | 'linkedin' | 'site' }[];
  class?: string;
}

const { liens, class: classe } = Astro.props;
const presents = liens.filter((l) => l.href);
---

{presents.length > 0 && (
  <div class:list={['mt-4 flex flex-wrap gap-3', classe]} data-cascade>
    {/* La flèche dit que le lien sort du site ; le texte caché le dit aux lecteurs d'écran, et nomme le réseau quand seul le logo se voit. */}
    {presents.map((l) =>
      l.icone ? (
        <a
          class="inline-flex size-9 items-center justify-center rounded-full border border-front transition-colors duration-200 hover:bg-front hover:text-back focus-visible:bg-front focus-visible:text-back tactile:size-11"
          href={l.href!}
          target="_blank"
          rel="noopener"
        >
          <IconeReseau nom={l.icone} />
          <span class="sr-only">
            {l.label}
            {T.nouvelOnglet}
          </span>
        </a>
      ) : (
        <Pastille class="after:ml-[.35em] after:text-[.8em] after:content-['↗']" href={l.href!} target="_blank" rel="noopener">
          {l.label}
          <span class="sr-only">{T.nouvelOnglet}</span>
        </Pastille>
      )
    )}
  </div>
)}
