---
// La grille de la galerie et sa visionneuse.
//
// La visionneuse est un <dialog> ouvert par showModal() : le navigateur y
// garde le focus et le ferme sur Échap, sans script. Le script ajoute les
// flèches (boutons et clavier), le balayage du doigt, la fermeture d'un clic
// à côté, et rend le focus à la vignette d'où l'on vient.
//
// La grande image n'est demandée qu'à l'ouverture : ses srcset (AVIF et WebP)
// attendent sur le bouton de la vignette, et le navigateur choisit format et
// taille. Le temps qu'elle arrive, la visionneuse montre la vignette déjà
// chargée, jamais une case vide ; ses deux voisines suivent, en priorité
// basse, pour que les flèches soient instantanées. Comme le portfolio
// (61e2bf7, 1de987e).
import Photo from './Photo.astro';
import Pastille from './Pastille.astro';
import { grande, vignetteGalerie } from '../lib/images.js';
import { T } from '../lib/textes.js';
import { tx, typographier } from '../lib/typo.js';

interface Props {
  photos: { id: string; caption: string; image: any; width?: number | null; height?: number | null; apercu: string; cle?: string | null }[];
  // Les filtres : voir groupesGalerie(). Vide, pas de rangée.
  groupes?: { clé: string; titre: string }[];
}

const { photos, groupes = [] } = Astro.props;
// Les flèches de la visionneuse, de part et d'autre de l'image.
const flèche = 'absolute top-1/2 min-h-11 min-w-11 -translate-y-1/2 p-4 text-[3rem] opacity-75';
// Seule la première vignette part tout de suite, en priorité haute : c'est le LCP de la page. À 390 px
// elle est la seule à l'écran ; les trois suivantes, aussi en priorité haute, se disputaient la bande
// passante avec elle (mesuré en local, Lighthouse mobile : 88 → 99, LCP 3,9 → 1,9 s). Les autres, en
// `lazy`, partent dès que la mise en page les met dans l'écran, sans retard sensible.
const tuiles = await Promise.all(
  photos.map(async (p) => {
    const taille = { width: p.width ?? null, height: p.height ?? null };
    return {
      caption: p.caption,
      cle: p.cle ?? '',
      vignette: await vignetteGalerie(p.image, taille, p.apercu),
      grande: await grande(p.image, taille),
    };
  })
);
---

{groupes.length > 0 && (
  <div class="js-filtres mt-respiration flex flex-wrap gap-2 sans-js:hidden" role="group" aria-label={T.filtrerGalerie} data-cascade>
    {[{ clé: '', titre: T.toutesLesPhotos }, ...groupes].map((g, i) => (
      <Pastille
        type="button"
        class="aria-pressed:bg-front aria-pressed:text-back"
        data-filtre={g.clé}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {typographier(g.titre)}
      </Pastille>
    ))}
  </div>
)}
<p class="js-compte sr-only" aria-live="polite" data-un={T.nombrePhotos(1)} data-plusieurs={T.nombrePhotos('{n}')}></p>

<div class:list={['columns-[3_18rem] gap-x-4', groupes.length > 0 ? 'mt-8' : 'mt-respiration']}>
  {tuiles.map((t, i) => (
    <figure class="mb-4 break-inside-avoid" data-cascade data-groupe={t.cle}>
      <button
        class="group js-vignette block w-full cursor-zoom-in"
        type="button"
        data-srcset={t.grande.srcset}
        data-avif={t.grande.avif}
        data-ratio={t.grande.width / t.grande.height}
        data-src={t.grande.src}
        data-sizes={t.grande.sizes}
        data-legende={typographier(t.caption)}
        aria-label={typographier(T.agrandir(t.caption))}
      >
        <Photo
          img={t.vignette}
          alt={t.caption}
          eager={i < 1}
          class="h-auto w-full animate-[fadein_.6s_ease_both] transition-opacity duration-250 group-hover:opacity-85 group-focus-visible:opacity-85"
        />
      </button>
      <figcaption class="px-1 py-[.35rem] text-xs opacity-75" set:html={tx(t.caption)} />
    </figure>
  ))}
</div>

<dialog
  class="js-visionneuse fixed inset-0 z-50 m-0 size-full max-h-none max-w-none touch-pan-y overscroll-contain bg-back/94 px-4 pt-14 pb-10 text-front backdrop:bg-transparent open:flex open:animate-[fadein_.3s_ease_both] open:items-center open:justify-center"
  aria-label={T.photoAgrandie}
  data-legende={T.légendeVisionneuse('{légende}', '{position}', '{total}')}
>
  <button
    class="js-fermer absolute top-[calc(1rem+var(--safe-top))] right-4 min-h-11 rounded-[2rem] border border-front px-[.9rem] py-[.35rem]"
    type="button"
  >
    {T.fermer}
  </button>
  <button class={`${flèche} left-0`} type="button" data-pas="-1" aria-label={T.photoPrécédente}>
    ‹
  </button>
  <img class="max-h-full max-w-full object-contain" alt="" />
  <button class={`${flèche} right-0`} type="button" data-pas="1" aria-label={T.photoSuivante}>
    ›
  </button>
  <p class="js-legende absolute inset-x-0 bottom-4 text-center text-sm opacity-75" aria-live="polite"></p>
</dialog>

<script>
  // Le texte de la légende vient de la page (data-legende de la boîte) : importer
  // le dictionnaire mettrait aussi tout le texte légal dans le paquet de la galerie.
  const texteLégende = (
    modèle: string | undefined,
    légende: string | undefined,
    { position, total }: { position: number; total: number }
  ) =>
    (modèle ?? '')
      .replace('{légende}', () => légende ?? '')
      .replace('{position}', String(position))
      .replace('{total}', String(total));

  // La grande image d'une vignette, décodée : hors de la page, dans son propre
  // <picture>, pour que le navigateur y choisisse l'AVIF ; la source et les srcset
  // sont posés avant le src, sinon le petit WebP partirait d'abord. On attend `load`
  // avant decode() : sur WebKit, decode() d'une image détachée peut se résoudre
  // trop tôt. Le <picture> est gardé et affiché tel quel : l'<img> sortie de son
  // cadre referait son choix sans la source AVIF, et téléchargerait le WebP.
  const grandeImage = async (v: HTMLButtonElement, priorité: 'high' | 'low') => {
    const cadre = document.createElement('picture');
    cadre.className = 'contents';
    const img = document.createElement('img');
    if (v.dataset.avif) {
      const source = document.createElement('source');
      source.type = 'image/avif';
      source.sizes = v.dataset.sizes ?? '100vw';
      source.srcset = v.dataset.avif;
      cadre.append(source);
    }
    cadre.append(img);
    img.fetchPriority = priorité;
    img.decoding = 'async';
    img.sizes = v.dataset.sizes ?? '100vw';
    img.srcset = v.dataset.srcset ?? '';
    img.src = v.dataset.src ?? '';
    await new Promise<void>((ok, échec) => {
      img.addEventListener('load', () => ok(), { once: true });
      img.addEventListener('error', () => échec(), { once: true });
    });
    // Un décodage refusé n'empêche pas l'image de s'afficher au chargement.
    await img.decode().catch(() => {});
    return cadre;
  };

  // Chaque grande image n'est chargée qu'une fois : une promesse partagée par
  // l'affichage et le préchargement des voisines.
  const chargeur = (vignettes: HTMLButtonElement[]) => {
    const grandes = new Map<number, Promise<HTMLPictureElement>>();
    return (i: number, priorité: 'high' | 'low') => {
      let p = grandes.get(i);
      if (!p) {
        p = grandeImage(vignettes[i], priorité);
        // Une image en échec pourra être redemandée.
        p.catch(() => grandes.delete(i));
        grandes.set(i, p);
      }
      return p;
    };
  };

  // L'image affichée prend la place de la précédente dans la visionneuse,
  // à la taille de la photo contenue dans l'écran, qu'elle soit la vignette
  // ou la grande : sans ça, la vignette s'afficherait à sa petite taille
  // naturelle, puis sauterait. 6rem : les marges haute et basse de la
  // boîte (pt-14, pb-10), où vivent le bouton Fermer et la légende.
  const afficheur = (boîte: HTMLDialogElement) => {
    const classes = boîte.querySelector('img')?.className ?? '';
    let affichée: Element = boîte.querySelector('img')!;
    return (nœud: HTMLImageElement | HTMLPictureElement, alt: string, ratio: number) => {
      const img = nœud instanceof HTMLImageElement ? nœud : nœud.querySelector('img')!;
      img.className = classes;
      img.alt = alt;
      if (ratio) {
        img.style.aspectRatio = String(ratio);
        img.style.width = `min(100%, calc((100dvh - 6rem) * ${ratio}))`;
      }
      if (affichée !== nœud) affichée.replaceWith(nœud);
      affichée = nœud;
    };
  };

  const brancherCommandes = (boîte: HTMLDialogElement, avancer: (pas: number) => void) => {
    boîte.querySelector('.js-fermer')?.addEventListener('click', () => boîte.close());
    boîte.querySelectorAll<HTMLElement>('[data-pas]').forEach((b) => b.addEventListener('click', () => avancer(Number(b.dataset.pas))));
    // Un clic sur le fond (le dialogue lui-même, pas l'image ni un bouton) ferme.
    boîte.addEventListener('click', (e) => {
      if (e.target === boîte) boîte.close();
    });
    boîte.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') avancer(1);
      if (e.key === 'ArrowLeft') avancer(-1);
    });
  };

  // Le balayage : cinquante pixels décident.
  const SEUIL_BALAYAGE_PX = 50;
  const balayer = (boîte: HTMLDialogElement, avancer: (pas: number) => void) => {
    let x0: number | null = null;
    boîte.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    boîte.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > SEUIL_BALAYAGE_PX) avancer(dx < 0 ? 1 : -1);
      x0 = null;
    });
  };

  // Le filtre se garde dans l'adresse (?spectacle=slug) : un lien partagé le retrouve. `history.state`
  // est repassé tel quel, c'est là que le ClientRouter range sa position.
  const PARAMÈTRE = 'spectacle';
  const lireFiltre = (valides: string[]) => {
    const clé = new URL(location.href).searchParams.get(PARAMÈTRE) ?? '';
    return valides.includes(clé) ? clé : '';
  };
  const écrireFiltre = (clé: string) => {
    const url = new URL(location.href);
    if (clé) url.searchParams.set(PARAMÈTRE, clé);
    else url.searchParams.delete(PARAMÈTRE);
    history.replaceState(history.state, '', url);
  };

  // Une photo qui réapparaît remonte, plus vite qu'à l'arrivée sur la page (0,04 s par rang, 0,4 s au plus).
  const relancerApparition = (figure: HTMLElement, rang: number) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    figure.classList.remove('animate-rise');
    void figure.offsetWidth;
    figure.style.animationDelay = `${Math.min(rang * 0.04, 0.4)}s`;
    figure.classList.add('animate-rise');
  };

  const annoncer = (n: number) => {
    const compte = document.querySelector<HTMLElement>('.js-compte');
    if (!compte) return;
    compte.textContent = (n === 1 ? compte.dataset.un : compte.dataset.plusieurs)?.replace('{n}', String(n)) ?? '';
  };

  // Les pastilles montrent ou cachent les photos de leur groupe ; la clé vide (Tout) les montre toutes.
  const brancherFiltres = (figures: HTMLElement[]) => {
    const boutons = [...document.querySelectorAll<HTMLButtonElement>('.js-filtres [data-filtre]')];
    if (!boutons.length) return;
    const appliquer = (clé: string, parUtilisateur: boolean) => {
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtre === clé)));
      let rang = 0;
      for (const f of figures) {
        f.hidden = clé !== '' && f.dataset.groupe !== clé;
        if (!f.hidden && parUtilisateur) relancerApparition(f, rang++);
      }
      if (parUtilisateur) {
        écrireFiltre(clé);
        annoncer(figures.filter((f) => !f.hidden).length);
      }
    };
    boutons.forEach((b) => b.addEventListener('click', () => appliquer(b.dataset.filtre ?? '', true)));
    appliquer(lireFiltre(boutons.map((b) => b.dataset.filtre ?? '')), false);
  };

  // « Titre · 3 / 12 » : la position se compte parmi les photos que le filtre laisse voir.
  const écrireLégende = (boîte: HTMLDialogElement, légende: string | undefined, rang: { position: number; total: number }) => {
    boîte.querySelector<HTMLElement>('.js-legende')!.textContent = texteLégende(boîte.dataset.legende, légende, rang);
  };

  // Les indices des photos que le filtre laisse voir : la visionneuse ne parcourt qu'elles.
  const photosVisibles = (figures: HTMLElement[]) => {
    const visibles = () => figures.map((_, i) => i).filter((i) => !figures[i].hidden);
    const voisine = (depuis: number, pas: number) => {
      const liste = visibles();
      return liste[(liste.indexOf(depuis) + pas + liste.length) % liste.length];
    };
    // Le rang d'une photo parmi les visibles, pour la légende.
    const rang = (i: number) => ({ position: visibles().indexOf(i) + 1, total: visibles().length });
    return { voisine, rang };
  };

  document.addEventListener('astro:page-load', () => {
    const boîte = document.querySelector<HTMLDialogElement>('dialog.js-visionneuse');
    if (!boîte) return;
    const vignettes = [...document.querySelectorAll<HTMLButtonElement>('.js-vignette')];
    const figures = vignettes.map((v) => v.closest('figure')!);
    const { voisine, rang } = photosVisibles(figures);
    const économe = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let position = 0;
    let retour: HTMLElement | null = null;
    const charger = chargeur(vignettes);
    const afficher = afficheur(boîte);

    const montrer = () => {
      const i = position;
      const v = vignettes[i];
      const vignette = v.querySelector('img');
      const alt = vignette?.alt ?? '';
      const ratio = Number(v.dataset.ratio) || 0;
      écrireLégende(boîte, v.dataset.legende, rang(i));
      // D'abord la vignette déjà chargée, agrandie : la photo est là tout de
      // suite, et se précise quand la grande arrive.
      if (vignette?.currentSrc) {
        const aperçu = new Image();
        aperçu.src = vignette.currentSrc;
        afficher(aperçu, alt, ratio);
      }
      charger(i, 'high')
        .then((cadre) => {
          if (position === i && boîte.open) afficher(cadre, alt, ratio);
        })
        // Photo introuvable : la vignette agrandie reste à l'écran, il n'y a rien d'autre à montrer.
        .catch(() => {});
      // Les voisines sont un préchargement : qu'il échoue ne regarde personne.
      if (!économe) for (const pas of [1, -1]) charger(voisine(position, pas), 'low').catch(() => {});
    };
    const avancer = (pas: number) => {
      position = voisine(position, pas);
      montrer();
    };

    vignettes.forEach((v, i) =>
      v.addEventListener('click', () => {
        retour = v;
        position = i;
        montrer();
        boîte.showModal();
        boîte.querySelector<HTMLElement>('.js-fermer')?.focus();
      })
    );
    brancherCommandes(boîte, avancer);
    boîte.addEventListener('close', () => retour?.focus());
    balayer(boîte, avancer);
    brancherFiltres(figures);
  });
</script>
